<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NacreCraft.Primitives\NacreCraft.Primitives.csproj" />
    <ProjectReference Include="..\NacreCraft.Config\NacreCraft.Config.csproj" />
    <ProjectReference Include="..\NacreCraft.Util\NacreCraft.Util.csproj" />
    <ProjectReference Include="..\NacreCraft.Nbt\NacreCraft.Nbt.csproj" />
    <ProjectReference Include="..\NacreCraft.DataFixer\NacreCraft.DataFixer.csproj" />
    <ProjectReference Include="..\NacreCraft.Registry\NacreCraft.Registry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Alignment switches. Every one defaults to on; build with -p:NcStageChain=false (or any other name) to compile the old path back in -->
  <PropertyGroup>
    <NcStageChain Condition="'$(NcStageChain)' == ''">true</NcStageChain>
    <NcRegionFair Condition="'$(NcRegionFair)' == ''">true</NcRegionFair>
    <NcStageDeps Condition="'$(NcStageDeps)' == ''">true</NcStageDeps>
    <NcLightInStage Condition="'$(NcLightInStage)' == ''">true</NcLightInStage>
    <NcSharedRegion Condition="'$(NcSharedRegion)' == ''">true</NcSharedRegion>
    <DefineConstants Condition="'$(NcStageChain)' == 'true'">$(DefineConstants);NC_STAGE_CHAIN</DefineConstants>
    <DefineConstants Condition="'$(NcRegionFair)' == 'true'">$(DefineConstants);NC_REGION_FAIR</DefineConstants>
    <DefineConstants Condition="'$(NcStageDeps)' == 'true'">$(DefineConstants);NC_STAGE_DEPS</DefineConstants>
    <DefineConstants Condition="'$(NcLightInStage)' == 'true'">$(DefineConstants);NC_LIGHT_IN_STAGE</DefineConstants>
    <DefineConstants Condition="'$(NcSharedRegion)' == 'true'">$(DefineConstants);NC_SHARED_REGION</DefineConstants>
  </PropertyGroup>

</Project>
