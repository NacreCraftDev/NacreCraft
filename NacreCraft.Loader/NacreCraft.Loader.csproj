<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NacreCraft.Loader</AssemblyName>
    <RootNamespace>NacreCraft.Loader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NacreCraft\NacreCraft.csproj" />
    <ProjectReference Include="..\NacreCraft.ModLoader\NacreCraft.ModLoader.csproj" />
    <ProjectReference Include="..\NacreCraft.Client\NacreCraft.Client.csproj" />
    <ProjectReference Include="..\NacreCraft.Server\NacreCraft.Server.csproj" />
  </ItemGroup>

  <Import Project="..\NacreCraft.KernelDeploy.targets" />

  <Target Name="KillRunningLoader" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="taskkill /F /IM NacreCraft.Loader.exe /T"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low" />
    <Exec Command="pkill -f NacreCraft.Loader"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>

</Project>
