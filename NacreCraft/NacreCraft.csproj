<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>NacreCraft</PackageId>
    <Description>C#/.NET 10 open-source server matching vanilla Minecraft 26.2 exactly - main aggregation library</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--The boot layer sits beside the main library rather than in the kernel directory, so it is copied normally-->
    <ProjectReference Include="..\NacreCraft.Boot\NacreCraft.Boot.csproj" />
    <ProjectReference Include="..\NacreCraft.Registry\NacreCraft.Registry.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NacreCraft.Storage\NacreCraft.Storage.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NacreCraft.Resources\NacreCraft.Resources.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NacreCraft.Network\NacreCraft.Network.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NacreCraft.Commands\NacreCraft.Commands.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--The language table stays embedded: it is the one resource the kernel genuinely needs before any pack is open-->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="assets/nacrecraft/lang/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CleanRedundantSubLibraries" AfterTargets="Build">
    <ItemGroup>
      <RedundantSubLibraries Include="$(OutputPath)NacreCraft.*.dll" Exclude="$(OutputPath)NacreCraft.dll;$(OutputPath)NacreCraft.Boot.dll;$(OutputPath)NacreCraft.Logging.dll" />
    </ItemGroup>
    <Delete Files="@(RedundantSubLibraries)" />
    <Message Text="[CleanRedundantSubLibraries] Removed redundant sub-library dlls: %(RedundantSubLibraries.Filename)" Importance="high" />
  </Target>

</Project>
