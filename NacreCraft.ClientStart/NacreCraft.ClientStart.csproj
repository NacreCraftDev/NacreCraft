<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!--ReleaseNoMods is a publish profile rather than a debugger configuration, so it keeps the Release optimization-->
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseNoMods'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--The constant drives the conditional compilation that removes the loader call from the entry point-->
  <PropertyGroup Condition="'$(EnableModLoader)' != 'true'">
    <DefineConstants>$(DefineConstants);NC_NO_MODLOADER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NacreCraft\NacreCraft.csproj" />
    <ProjectReference Include="..\NacreCraft.ModLoader\NacreCraft.ModLoader.csproj" Condition="'$(EnableModLoader)' == 'true'" />
    <ProjectReference Include="..\NacreCraft.Client\NacreCraft.Client.csproj" />
  </ItemGroup>

  <Import Project="..\NacreCraft.KernelDeploy.targets" />

  <Target Name="KillRunningClient" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="taskkill /F /IM NacreCraft.ClientStart.exe /T"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low" />
    <Exec Command="pkill -f NacreCraft.ClientStart"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>

</Project>
