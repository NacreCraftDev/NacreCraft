<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NacreCraft.Server.Gui.ServerWindow"
        Title="Minecraft server"
        Width="854" Height="480"
        MinWidth="680" MinHeight="420"
        Background="{DynamicResource WindowBackground}">

  <!--Colors and fonts live here; the two themes are picked by the current ThemeVariant, and panels take styles only by Classes, so changing the look never touches C#-->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackground" Color="#F5F6F8" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#E3E6EA" />
          <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
          <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
          <SolidColorBrush x:Key="RowSeparator" Color="#EDEFF2" />
          <SolidColorBrush x:Key="ConsoleBackground" Color="#1E1F22" />
          <SolidColorBrush x:Key="ConsoleText" Color="#C9D1D9" />
          <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
          <SolidColorBrush x:Key="GraphBackground" Color="#F0F2F5" />
          <!--Chunk-map grid lines and the two load-level colors; the green and yellow use medium luminance so both light and dark backgrounds stay legible-->
          <SolidColorBrush x:Key="GridLine" Color="#22000000" />
          <SolidColorBrush x:Key="ChunkLoaded" Color="#3FB950" />
          <SolidColorBrush x:Key="ChunkWeak" Color="#D29922" />
          <!--Fixed marker for the world-center cell; the red stands out against both load-level colors-->
          <SolidColorBrush x:Key="ChunkOrigin" Color="#E5484D" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackground" Color="#17191C" />
          <SolidColorBrush x:Key="CardBackground" Color="#212328" />
          <SolidColorBrush x:Key="CardBorder" Color="#32353B" />
          <SolidColorBrush x:Key="TextPrimary" Color="#E4E6EA" />
          <SolidColorBrush x:Key="TextSecondary" Color="#8E959F" />
          <SolidColorBrush x:Key="RowSeparator" Color="#2C2F35" />
          <SolidColorBrush x:Key="ConsoleBackground" Color="#101215" />
          <SolidColorBrush x:Key="ConsoleText" Color="#C9D1D9" />
          <SolidColorBrush x:Key="Accent" Color="#60A5FA" />
          <SolidColorBrush x:Key="GraphBackground" Color="#1B1D22" />
          <!--Chunk-map grid lines and the two load-level colors; the green and yellow use medium luminance so both light and dark backgrounds stay legible-->
          <SolidColorBrush x:Key="GridLine" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="ChunkLoaded" Color="#3FB950" />
          <SolidColorBrush x:Key="ChunkWeak" Color="#D29922" />
          <!--Fixed marker for the world-center cell; the red stands out against both load-level colors-->
          <SolidColorBrush x:Key="ChunkOrigin" Color="#E5484D" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <!--The font does not change with the theme, so it stays outside-->
      <FontFamily x:Key="MonoFont">Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://NacreCraft.Server/ServerGui/Theme.axaml" />
  </Window.Styles>

  <!--Tabs; the main page is the original three cards, the LOG page is the log with filtering and search, and the CHUNK page is the chunk map-->
  <TabControl x:Name="Tabs" Margin="8,4,8,8" Padding="0">
    <TabItem Header="MAIN">
      <Grid Margin="4" ColumnDefinitions="320,12,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,12,*">
          <Border x:Name="StatsCard" Grid.Row="0" Classes="card" />
          <Border x:Name="PlayersCard" Grid.Row="2" Classes="card" />
        </Grid>
        <Border x:Name="LogCard" Grid.Column="2" Classes="card" />
      </Grid>
    </TabItem>

    <TabItem Header="LOG">
      <ContentControl x:Name="LogPageHost" Margin="4" />
    </TabItem>

    <TabItem x:Name="ChunkTab" Header="CHUNK">
      <ContentControl x:Name="ChunkPageHost" Margin="4" />
    </TabItem>

    <!--The MODS page is not here; NacreCraft-ModApi injects it when it hooks RefreshNow-->
  </TabControl>
</Window>
