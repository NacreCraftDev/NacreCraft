<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="using:NacreCraft.Server.Gui"
             x:Class="NacreCraft.Server.Gui.ServerLogPage">

  <Grid ColumnDefinitions="152,12,*">
    <!--Left side is the level filter; buttons are generated by the code-behind from the available levels, with an extra DBG only in debug-->
    <Border Grid.Column="0" Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="cardTitle" Text="LEVEL" />
        <StackPanel x:Name="Filters" Spacing="6" />
        <TextBlock x:Name="FilterStats" Classes="hintText" TextWrapping="Wrap" />
        <TextBlock Classes="hintText" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!--Right side is search on top and logs below, using the same rendering as the main-page log area, minus the command input-->
    <Grid Grid.Column="2" RowDefinitions="Auto,10,*">
      <Border Classes="card" Padding="10,7">
        <Grid ColumnDefinitions="*,8,Auto,8,Auto,6,Auto">
          <TextBox x:Name="SearchBox" Classes="searchBox"
                   Watermark="{x:Static gui:GuiText.LogSearchWatermark}" />
          <TextBlock x:Name="MatchLabel" Grid.Column="2" Classes="metricLabel"
                     VerticalAlignment="Center" MinWidth="52" TextAlignment="Right" />
          <Button x:Name="PrevButton" Grid.Column="4" Classes="navButton" Content="&#x2191;" />
          <Button x:Name="NextButton" Grid.Column="6" Classes="navButton" Content="&#x2193;" />
        </Grid>
      </Border>

      <Border Grid.Row="2" CornerRadius="4"
              Background="{DynamicResource ConsoleBackground}"
              BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <!--Logs do not wrap; overflow is viewed via the horizontal scrollbar, and without Auto long lines are simply cut off-->
        <!--Uses a ListBox rather than a StackPanel because it virtualizes, keeping the layout of two thousand lines down to the few dozen visible ones-->
        <!--Search hits are picked out and highlighted inline by LogRowSpans, marking only the words and not the whole row-->
        <ListBox x:Name="LogLines" Classes="plain" Padding="8,6"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ContainerPrepared="OnRowPrepared">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="gui:LogRow">
              <TextBlock Classes="logLine"
                         gui:LogRowSpans.Spans="{Binding Spans}"
                         gui:LogRowSpans.Matches="{Binding Matches}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
  </Grid>

</UserControl>
