<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--Card: white background, rounded corners, thin border; carries the Stats/Players/Log areas-->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!--Card subtitle: small secondary-colored text, set apart from the content-->
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>

  <!--Metric row label and value; the value is right-aligned and bold for easy scanning-->
  <Style Selector="TextBlock.metricLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.metricValue">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--One row of the player list; thin separator lines between rows instead of a selection highlight-->
  <Style Selector="TextBlock.listRow">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.listRowBox">
    <Setter Property="BorderBrush" Value="{DynamicResource RowSeparator}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="2,6" />
  </Style>

  <!--Log line: monospace font, light text on a dark background; inline colors are applied per segment by AnsiLogParser-->
  <Style Selector="TextBlock.logLine">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Padding" Value="0,1" />
  </Style>

  <!--Command input: removes Fluent's default border and minimum height, leaving the look to the outer Border-->
  <Style Selector="TextBox.command">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ConsoleText}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ConsoleText}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <!--The highlight ring on focus is drawn by the adorner, not the template; turn it off-->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <!--Without naming template elements, it covers every Border inside the template; on focus Fluent paints some Border's background with the theme focus color-->
  <Style Selector="TextBox.command /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--The focus state must be written separately; a selector with a pseudo-class has higher priority, and covering only the stateless one cannot stop it-->
  <Style Selector="TextBox.command:focus">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBox.command:focus /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--Plain list: removes the selection and hover highlights and all padding, leaving only the content itself-->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.plain ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!--The command box is disabled until the server is ready; dimmed one step to distinguish it from the editable state; disabling is toggled by the panel based on Running-->
  <Style Selector="TextBox.command:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!--The search box on the log page sits on a light card, so it cannot reuse the dark-background light-text style of the command box-->
  <Style Selector="TextBox.searchBox">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <Style Selector="TextBox.searchBox /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--On an invalid regex, draw a red background to signal that this search took no effect, rather than clearing all logs-->
  <Style Selector="TextBox.searchBox.invalid /template/ Border">
    <Setter Property="Background" Value="#22F87171" />
    <Setter Property="BorderBrush" Value="#F87171" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!--Level filter toggle: transparent background, text in the level's own color, and on selection a faint matching background with a border-->
  <Style Selector="ToggleButton.levelToggle">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <!--Scales down on press as feedback and springs back on release; an elastic easing curve keeps the transition from feeling stiff-->
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.levelToggle:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.dbg">
    <Setter Property="Foreground" Value="#22D3EE" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.info">
    <Setter Property="Foreground" Value="#4ADE80" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.warn">
    <Setter Property="Foreground" Value="#FACC15" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.error">
    <Setter Property="Foreground" Value="#F87171" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.crit">
    <Setter Property="Foreground" Value="#C084FC" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.dbg:checked">
    <Setter Property="Background" Value="#3322D3EE" />
    <Setter Property="BorderBrush" Value="#22D3EE" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.info:checked">
    <Setter Property="Background" Value="#334ADE80" />
    <Setter Property="BorderBrush" Value="#4ADE80" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.warn:checked">
    <Setter Property="Background" Value="#33FACC15" />
    <Setter Property="BorderBrush" Value="#FACC15" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.error:checked">
    <Setter Property="Background" Value="#33F87171" />
    <Setter Property="BorderBrush" Value="#F87171" />
  </Style>

  <Style Selector="ToggleButton.levelToggle.crit:checked">
    <Setter Property="Background" Value="#33C084FC" />
    <Setter Property="BorderBrush" Value="#C084FC" />
  </Style>

  <!--Match navigation button: a small square, scales down on press like the filter toggles, with a slight background on hover-->
  <Style Selector="Button.navButton">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.navButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.9)" />
  </Style>

  <Style Selector="Button.navButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowSeparator}" />
  </Style>

  <!--Small caption text; the note in the filter area uses it-->
  <Style Selector="TextBlock.hintText">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <!--Coordinate row on the chunk page; monospace font aligns the block coordinates across the lines above and below-->
  <Style Selector="TextBlock.monoValue">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Padding" Value="0,1" />
  </Style>

  <!--Player toggle on the chunk page, one per row; on selection an accent border with a faint background distinguishes it from the unselected ones beside it-->
  <Style Selector="ToggleButton.playerToggle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.playerToggle:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <Style Selector="ToggleButton.playerToggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowSeparator}" />
  </Style>

  <Style Selector="ToggleButton.playerToggle:checked">
    <Setter Property="Background" Value="#333B82F6" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

</Styles>
