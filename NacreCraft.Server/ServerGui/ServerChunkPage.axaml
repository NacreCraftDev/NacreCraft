<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="using:NacreCraft.Server.Gui"
             x:Class="NacreCraft.Server.Gui.ServerChunkPage">

  <Grid ColumnDefinitions="168,12,*">
    <!--Top-left lists in-progress generation tasks, bottom-left is the player list, and below that is the entry to jump to a given chunk-->
    <Border Grid.Column="0" Classes="card">
      <Grid RowDefinitions="Auto,6,Auto,10,*,10,Auto,6,Auto,10,Auto,6,Auto,6,Auto">
        <TextBlock Grid.Row="0" Classes="cardTitle" Text="{x:Static gui:GuiText.ChunkTerrain}" />
        <TextBlock Grid.Row="2" x:Name="GenerationSummary" Classes="hintText" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="GenerationList" Spacing="1" />
        </ScrollViewer>

        <TextBlock Grid.Row="6" Classes="cardTitle" Text="{x:Static gui:GuiText.ChunkPlayers}" />
        <ScrollViewer Grid.Row="8" MaxHeight="220" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PlayerList" Spacing="4" />
        </ScrollViewer>

        <TextBlock Grid.Row="10" Classes="cardTitle" Text="{x:Static gui:GuiText.ChunkGotoSection}" />
        <Grid Grid.Row="12" ColumnDefinitions="*,6,*">
          <TextBox x:Name="GotoX" PlaceholderText="X" />
          <TextBox x:Name="GotoZ" Grid.Column="2" PlaceholderText="Z" />
        </Grid>
        <Button Grid.Row="14" x:Name="GotoButton" Content="{x:Static gui:GuiText.ChunkGoto}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </Grid>
    </Border>

    <!--Right side is the grid map; a strip on top holds the center coordinates, hovered cell, zoom, and legend-->
    <Grid Grid.Column="2" RowDefinitions="Auto,10,*">
      <Border Classes="card" Padding="10,7">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock x:Name="CenterLabel" Classes="metricLabel" />
            <TextBlock x:Name="HoverLabel" Classes="metricLabel" />
            <TextBlock x:Name="ScaleLabel" Classes="metricLabel" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Border Width="10" Height="10" CornerRadius="2"
                      Background="{DynamicResource ChunkLoaded}" VerticalAlignment="Center" />
              <TextBlock Classes="metricLabel" Text="{x:Static gui:GuiText.ChunkStrong}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Border Width="10" Height="10" CornerRadius="2"
                      Background="{DynamicResource ChunkWeak}" VerticalAlignment="Center" />
              <TextBlock Classes="metricLabel" Text="{x:Static gui:GuiText.ChunkWeak}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Border Width="10" Height="10" CornerRadius="2"
                      Background="{DynamicResource GraphBackground}" VerticalAlignment="Center" />
              <TextBlock Classes="metricLabel" Text="{x:Static gui:GuiText.ChunkUnloaded}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Border Width="10" Height="10" CornerRadius="5"
                      Background="{DynamicResource ChunkOrigin}" VerticalAlignment="Center" />
              <TextBlock Classes="metricLabel" Text="{x:Static gui:GuiText.ChunkWorldCenter}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" CornerRadius="4" ClipToBounds="True"
              BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <gui:ChunkGridView x:Name="ChunkGrid"
                           GridBackground="{DynamicResource GraphBackground}"
                           GridLine="{DynamicResource GridLine}"
                           LoadedBrush="{DynamicResource ChunkLoaded}"
                           WeakBrush="{DynamicResource ChunkWeak}"
                           MarkerBrush="{DynamicResource Accent}"
                           OriginBrush="{DynamicResource ChunkOrigin}" />
      </Border>
    </Grid>
  </Grid>

</UserControl>
